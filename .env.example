# Supabase → Project Settings → API (or "Connect" → App Frameworks → Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) — or the legacy "anon" public key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Optional: absolute site URL used for the email-confirmation redirect.
# Defaults to the request origin. Set to your Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

